<?xml version="1.0" encoding="utf-8"?>
<!--
    canRetrieveWindowContent  -> read the browser's toolbar to learn whether Back/Forward are enabled
    canPerformGestures        -> reserved for a "reveal the hidden toolbar" fallback; unused so far
    flagReportViewIds         -> resource ids on nodes, so the toolbar buttons can be found by id
    flagRetrieveInteractiveWindows -> windows list with display ids, so the overlay follows the fold

    Events are limited to window changes. The service never listens to content changes; it reads
    the toolbar only at the moment of a swipe.

    No packageNames filter: we need the event that says the browser left the foreground too.
    isAccessibilityTool is deliberately not set; this is not an assistive technology.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/accessibility_service_description"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowsChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:notificationTimeout="50"
    android:settingsActivity="com.ioscastaway.edgerewire.ui.MainActivity" />
